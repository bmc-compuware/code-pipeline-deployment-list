{
  "name": "code-pipeline-deployment-list",
  "version": "1.1.0",
  "description": "Retrieves Codepipeline deployments using optional filter criteria.",
  "publisher": "BMC",
  "main": "./dist/index.js",
  "scripts": {
    "build": "ncc build index.js -o dist",
    "lint": "npx eslint ./**.js --fix",
    "test": "nyc --all=true --exclude=\"dist/**\" --exclude=\"coverage/**\" --exclude=\"test/**\" --reporter=json --reporter=text mocha",
    "coverage": "nyc check-coverage --lines 80 --branches 80 --statements 80 --functions 80",
    "check": "npm run lint && npm run build && npm run test && npm run coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmc-compuware/code-pipeline-deployment-list.git"
  },
  "keywords": [
    "ISPW",
    "Compuware",
    "BMC",
    "AMI",
    "DevX",
    "codepipeline",
    "deployment list"
  ],
  "author": "BMC Software, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bmc-compuware/code-pipeline-deployment-list/issues"
  },
  "homepage": "https://github.com/bmc-compuware/code-pipeline-deployment-list#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@bmc-compuware/ispw-action-utilities": "https://github.com/bmc-compuware/ispw-action-utilities.git"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "chai": "^4.3.4",
    "eslint": "^9.20.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^22.0.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  }
}
